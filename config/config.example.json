{
  "port": 3777,
  "bindHost": "0.0.0.0",
  "parentPin": "1234",
  "hotkey": "F8",
  "language": "en-US",

  "claude": {
    "executable": "%USERPROFILE%\\.local\\bin\\claude.exe",
    "workspace": "%LOCALAPPDATA%\\Robo\\workspace",
    "model": null,
    "maxTurns": 40
  },

  "roblox": {
    "mcpBat": "%LOCALAPPDATA%\\Roblox\\mcp.bat",
    "serverName": "Roblox_Studio"
  },

  "policy": {
    "askBeforeDelete": false,
    "askBeforeGenerate": false,
    "allowUploadImage": false,
    "playtest": false,
    "saveProgress": false
  },

  "stt": {
    "provider": "webspeech",
    "deepgram": { "apiKey": "", "model": "nova-3" }
  },

  "tts": {
    "provider": "edge",
    "elevenlabs": { "apiKey": "", "voiceId": "", "model": "eleven_flash_v2_5" },
    "fish": {
      "apiKey": "", "referenceId": "", "model": "s2.1-pro-free",
      "voices": []
    },
    "edge": { "voiceMatch": "Online \\(Natural\\)" }
  },

  "session": {
    "maxMinutes": 45,
    "breakMinutes": 15
  },

  "handsFree": {
    "enabled": false,
    "sleepAfterMin": 2,
    "pauseMs": 1500
  },

  "math": {
    "enabled": false,
    "tables": [2, 3, 4, 5],
    "bonusEvery": 5
  },

  "bedtime": {
    "enabled": false,
    "warnAt": "19:15",
    "at": "20:00",
    "wakeAt": "07:00",
    "timeZone": ""
  },

  "update": {
    "checkIntervalMin": 10,
    "auto": true
  },

  "window": {
    "width": 340,
    "height": 460,
    "anchor": "bottom-left",
    "margin": 10
  }
}
