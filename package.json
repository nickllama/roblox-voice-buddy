{
  "name": "robo",
  "version": "0.1.0",
  "private": true,
  "description": "Робо: голосовой помощник для ребёнка в Roblox Studio",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.mjs",
    "e2e": "node --import tsx tests/e2e-fake-studio.mjs",
    "check-secrets": "node scripts/check-secrets.mjs",
    "dev:fake": "node scripts/dev-fake.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "zod": "^4.6.7"
  }
}
